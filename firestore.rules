rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /resources/{resourceId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /practicum_studio_modules/{moduleId} {
      allow read, create, update, delete: if true;
    }

    match /practicum_rosters/{rosterId} {
      allow read, create, update, delete: if true;
    }

    match /practicum_attendance_sessions/{sessionId} {
      allow read, create, update, delete: if true;
    }

    match /practicum_attendance_records/{recordId} {
      allow read, create, update, delete: if true;
    }

    match /hms_active_members/{memberId} {
      allow read, create, update, delete: if true;
    }

    match /student_gpa_records/{recordId} {
      allow read, create, update, delete: if true;
    }

    match /videos/{videoId} {
      allow read, create, update, delete: if true;
    }

    match /announcements/{announcementId} {
      allow read, create, update, delete: if true;
    }

    match /resource_access_logs/{logId} {
      allow read, create: if true;
      allow update: if false;
      allow delete: if true;
    }

    match /client_error_logs/{logId} {
      allow read, delete: if true;
      allow create: if request.resource.data.keys().hasOnly([
        'type', 'message', 'source', 'stack', 'page', 'userAgent', 'createdAt'
      ])
      && request.resource.data.message is string
      && request.resource.data.message.size() <= 500;
      allow update: if false;
    }

    match /admin_audit_logs/{logId} {
      allow read, create: if true;
      allow update: if false;
      allow delete: if true;
    }

    match /admin_push_tokens/{tokenId} {
      allow read: if false;
      allow create, update, delete: if true;
    }

    match /student_push_tokens/{tokenId} {
      allow read: if false;
      allow create, update, delete: if true;
    }

    match /admin_activity/{adminId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    match /admin_practicum_scopes/{adminId} {
      allow read, create, update, delete: if true;
    }

    match /site_settings/{settingId} {
      allow read: if true;
      allow create, update: if settingId in ['academic_period', 'maintenance']
        && request.resource.data.keys().hasOnly([
          'overrideEnabled', 'overrideAcademicYearStart', 'overrideTerm', 'overrideNote',
          'autoOddPeriod', 'autoEvenPeriod', 'enabled', 'title', 'message',
          'updatedAt', 'updatedBy'
        ]);
      allow create, update: if settingId == 'course_catalog'
        && request.resource.data.keys().hasOnly([
          'sksByCode', 'courseOverrides', 'updatedAt', 'updatedBy'
        ]);
      allow delete: if false;
    }

    match /contact_messages/{messageId} {
      allow read, create, update, delete: if true;
    }

    match /live_chat_messages/{messageId} {
      allow read, create, update, delete: if true;
    }
  }
}
